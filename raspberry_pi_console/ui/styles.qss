
            QMainWindow { background: #eef1f4; }
            QMenuBar { background: transparent; color: #26323c; border: none; padding: 4px; }
            QMenuBar::item { padding: 6px 12px; }
            QMenuBar::item:selected { background: #bcc6d0; }
            #MenuWidgetBar {
                background: #d9dee5; border: none; border-bottom: 1px solid #b7c0c9;
            }
            #MainMenuBar { background: transparent; }
            #MenuBarControls { background: transparent; }
            QMenu { background: #f7f8fa; color: #24313b; border: 1px solid #b8c1ca; }
            QMenu::item:selected { background: #ea8b2d; color: #111111; }
            QStatusBar { background: #d9dee5; color: #546270; border-top: 1px solid #b7c0c9; }
            QPushButton {
                background: #4a5864; color: #ffffff; border: 1px solid #41505c;
                padding: 7px 14px; border-radius: 4px;
            }
            QPushButton:hover { background: #ea8b2d; border: 1px solid #d87916; color: #111111; }
            QPushButton:disabled { background: #aab4be; color: #e8edf2; border: 1px solid #aab4be; }
            #PowerShellButton { background: #2b6cb0; border: 1px solid #245a96; color: #ffffff; }
            #PowerShellButton:hover { background: #3b82d0; border: 1px solid #2f6db2; color: #ffffff; }
            QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextBrowser, QTableWidget {
                background: #ffffff; color: #23303a; border: 1px solid #b8c1ca; selection-background-color: #ea8b2d;
            }
            QHeaderView::section { background: #d8e0e8; color: #24303a; padding: 6px; border: 1px solid #bac3cc; }
            QTableWidget { gridline-color: #d6dde5; alternate-background-color: #f4f6f8; }
            QGroupBox {
                border: 1px solid #c3ccd5; border-radius: 6px; margin-top: 10px; padding-top: 10px; color: #2b3741;
                background: #f8f9fb;
            }
            QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
            #Header { background: #f7f8fa; border: 1px solid #c2cbd4; border-left: 6px solid #ea8b2d; }
            #Title { color: #25313b; font-size: 18px; font-weight: 800; letter-spacing: 1px; }
            #SubTitle { color: #6b7782; font-size: 10px; }
            #StatusText { color: #1f2c35; font-weight: 700; }
            #MenuDeviceLabel, #MenuNetworkLabel { color: #546270; font-weight: 700; }
            #NetworkModeSwitch {
                background: #cbd3dc; border: 1px solid #b8c1ca; border-radius: 5px;
            }
            #NetworkModeButtonLeft, #NetworkModeButtonRight {
                padding: 5px 14px; min-width: 68px; background: transparent; color: #33414d;
                border: none; border-radius: 0;
            }
            #NetworkModeButtonLeft { border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
            #NetworkModeButtonRight {
                border-top-right-radius: 4px; border-bottom-right-radius: 4px;
                border-left: 1px solid #b8c1ca;
            }
            #NetworkModeButtonLeft:checked, #NetworkModeButtonRight:checked {
                background: #ea8b2d; color: #111111; font-weight: 700;
            }
            #NetworkModeButtonLeft:disabled, #NetworkModeButtonRight:disabled {
                background: transparent; color: #aab4be;
            }
            #RefreshHint { color: #6b7782; }
            #OutputView, #LogsView { font-family: Consolas, "Microsoft YaHei"; font-size: 10.5pt; }
            #HeaderMetricCard {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffffff, stop:1 #eef2f6);
                border: 1px solid #c4ccd4; border-radius: 6px;
            }
            #HeaderMetricTitle { color: #5e6b77; font-size: 12px; font-weight: 800; }
            #HeaderMetricValue { color: #1f2a33; font-size: 15px; font-weight: 800; }
            #HeaderMetricHint { color: #75818c; font-size: 8.5px; }
            #HeaderUsageBar {
                background: #d7dde4; border: 1px solid #c2c9d0; border-radius: 3px; min-height: 8px; max-height: 8px;
            }
            #HeaderUsageBar::chunk { background: #3c98d8; border-radius: 2px; }
            #StatusBanner {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f6efe6, stop:1 #f3f5f7);
                border: 1px solid #d3b184; border-left: 6px solid #ea8b2d; border-radius: 8px;
            }
            #HealthLabel { color: #7a4c17; font-size: 16px; font-weight: 800; }
            #HealthSummary { color: #475560; font-size: 10.5pt; }
            #StatCard {
                background: #ffffff; border: 1px solid #ccd3db; border-radius: 6px;
            }
            #StatTitle { color: #6a7681; font-size: 10px; font-weight: 700; }
            #StatValue { color: #22303a; font-size: 14px; font-weight: 700; }
            #TransferHint { color: #6c7884; padding: 6px 0; }
            #TransferOptionButton {
                background: #ffffff; color: #31404c; border: 1px solid #c4ccd4; border-radius: 6px; padding: 7px 12px;
            }
            #TransferOptionButton:checked {
                background: #ea8b2d; color: #111111; border: 1px solid #d87916; font-weight: 700;
            }
            #TransferPreview { font-family: Consolas, "Microsoft YaHei"; font-size: 10pt; }
            #TransferProgressBar {
                background: #d7dde4; border: 1px solid #c2c9d0; border-radius: 3px; min-height: 14px; max-height: 14px;
            }
            #TransferProgressBar::chunk { background: #ea8b2d; border-radius: 2px; }
            QTabWidget::pane { border: 1px solid #c8d0d8; background: #f1f4f7; }
            QTabBar::tab {
                background: #dbe2e9; color: #31404c; padding: 8px 14px; border: 1px solid #bec7d0; margin-right: 2px;
            }
            QTabBar::tab:selected { background: #ea8b2d; color: #111111; font-weight: 700; }
            
